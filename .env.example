# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# Bearer token for https://mcp.ctrader.com/trading/mcp .
# It is a single opaque JWT-shaped string whose payload contains
# {"plant":"icmarkets","environment":"demo"|"live","token":"..."}.
# Never split it into host + token, and never put it in a URL.
# The bot decodes and LOGS the environment on start-up, so you can always see
# whether it is pointed at a DEMO or LIVE account.
CTRADER_MCP_TOKEN=replace-me-with-your-bearer-token
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
TRADING_MODE=paper   # or "live" — bot must refuse to place real orders unless explicitly "live"

# ---------------------------------------------------------------------------
# SAFETY (optional — the defaults are the safe ones)
# ---------------------------------------------------------------------------
# Second switch required before real orders go to a LIVE (non-demo) account.
# TRADING_MODE=live alone is not enough.
ALLOW_LIVE_ENVIRONMENT=false
# Emergency stop: blocks every new order without redeploying.
KILL_SWITCH=false

# ---------------------------------------------------------------------------
# RISK
# ---------------------------------------------------------------------------
RISK_PER_TRADE_PCT=1.0
# 0 disables the daily halt entirely. Note it counts EVERY deal on the
# account since local midnight, including trades you place by hand.
DAILY_MAX_DRAWDOWN_PCT=3.0

# --- Manual sizing (optional) ---------------------------------------------
# FIXED_LOT_SIZE pins the size of EACH layer and bypasses percentage sizing, so
# the bot will take a setup that RISK_PER_TRADE_PCT would have refused. Risk then
# varies with the stop distance; the real figure is logged and sent to Telegram
# on every order. 0 = off (size from RISK_PER_TRADE_PCT).
FIXED_LOT_SIZE=0
# Split the entry into N laddered limit orders across the fair value gap.
# Rung 1 sits at the edge price reaches first, the last at the far edge, so a
# deeper retracement fills more of the position at a better price. 1 = single order.
ENTRY_LAYERS=1
# Safety ceiling on TOTAL risk across the ladder, as a % of balance. Applies to
# fixed sizing. 0 = no ceiling. The daily drawdown limit still applies either way.
MAX_RISK_PCT=10
MIN_RR=2.0
MAX_SPREAD_POINTS=35
SL_BUFFER_POINTS=20
INCLUDE_OPEN_PNL_IN_DRAWDOWN=true
MIN_ACCOUNT_BALANCE=0
# Backstop against a price-scale failure: refuses a position whose notional
# exceeds this multiple of the balance.
MAX_NOTIONAL_LEVERAGE=500

# ---------------------------------------------------------------------------
# INSTRUMENTS & TRADING CALENDAR
# ---------------------------------------------------------------------------
# XAUUSD is shut from Friday evening to Sunday evening; BTCUSD trades 24/7, so
# the weekend belongs to crypto. Set WEEKEND_TRADING=false to idle instead.
SYMBOL=XAUUSD            # Mon-Fri
WEEKEND_SYMBOL=BTCUSD    # Sat/Sun
WEEKEND_TRADING=true
# The variables below apply to the WEEKDAY symbol only. Each instrument carries
# its own built-in profile, because a "point" means very different things per
# market: measured live, gold's median M1 body is 35 points while Bitcoin's is
# ~2,960. Applying gold's 35-point spread cap to BTC would reject every trade.
POINT_SIZE=0.01          # 1 point; 1 pip = 10 points on gold
CONTRACT_SIZE=100        # ounces per 1.00 lot
VOLUME_STEP=0.01
MIN_VOLUME=0.01
MAX_VOLUME=100

# Per-symbol overrides use the <SYMBOL>_<FIELD> form and beat everything else.
# The BTCUSD defaults below are what the bot already uses - shown so they are
# easy to tune. CONFIRM BTCUSD_CONTRACT_SIZE against your cTrader symbol
# specification: it is the one value the API does not publish.
# BTCUSD_CONTRACT_SIZE=1
# BTCUSD_MAX_SPREAD_POINTS=700
# BTCUSD_SL_BUFFER_POINTS=1000
# BTCUSD_MIN_FVG_POINTS=400
# BTCUSD_MIN_DISPLACEMENT_POINTS=2000
# BTCUSD_MIN_SWEEP_PENETRATION_POINTS=200
# BTCUSD_EQUAL_LEVEL_TOLERANCE_POINTS=1000
# BTCUSD_MAX_VOLUME=10
# auto | lots | units | centiunits — auto reads the live create_order schema.
# Against the real cTrader server this resolves to centiunits: the schema
# declares `volume` as an integer, and lot sizes are fractional, so volume is
# carried as 1/100 of a unit (0.10 BTC -> 10; 0.08 lots of gold -> 800).
VOLUME_UNIT_MODE=auto
# auto-detected from the live feed; override only if the numbers look wrong.
PRICE_SCALE=auto
MONEY_SCALE=auto

# ---------------------------------------------------------------------------
# STRATEGY
# ---------------------------------------------------------------------------
ENTRY_TIMEFRAME=M1
STRUCTURE_TIMEFRAME=M5
HTF_TIMEFRAME=H1
ENTRY_BARS=360
STRUCTURE_BARS=300
HTF_BARS=200
SWING_STRENGTH=2
DISPLACEMENT_BODY_MULT=1.6
MIN_DISPLACEMENT_POINTS=30
MIN_FVG_POINTS=8
FVG_ENTRY_MODE=proximal   # proximal | mid (consequent encroachment) | distal
SWEEP_LOOKBACK_MINUTES=45
MIN_SWEEP_PENETRATION_POINTS=3
EQUAL_LEVEL_TOLERANCE_POINTS=15

# ---------------------------------------------------------------------------
# EXECUTION / OPS
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=15
ORDER_EXPIRY_MINUTES=60
CANCEL_UNFILLED_AT_WINDOW_END=true
BLOCK_IF_ANY_SYMBOL_EXPOSURE=true
ORDER_LABEL_PREFIX=SB
MCP_CALL_TIMEOUT_SECONDS=15
MCP_CONNECT_TIMEOUT_SECONDS=20
RECONNECT_BASE_DELAY_SECONDS=2
RECONNECT_MAX_DELAY_SECONDS=60
AUTH_FAILURE_DELAY_SECONDS=300
LOG_LEVEL=INFO
STATE_DIR=/tmp/silver-bullet-state
# Escape hatch: literal extra fields merged into create_order, as JSON.
# Only needed if your server build requires a parameter this bot does not know.
# EXTRA_ORDER_FIELDS={"accountId": 123456}
